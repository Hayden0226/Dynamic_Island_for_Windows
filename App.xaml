<Application x:Class="DynamicIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7C9CFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8E8E93" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF6E6E73" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#22FFFFFF" />
    </Application.Resources>
</Application>

